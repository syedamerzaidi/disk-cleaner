<Window x:Class="DiskCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk Cleaner" Width="1180" Height="780" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Small square button holding one icon. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Rows in the cleanup list. -->
        <DataTemplate x:Key="CleanItemTemplate">
            <Grid Margin="52,6,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanClean}" MinWidth="0" VerticalAlignment="Top" Margin="0,2,8,0"
                          Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolVis}}"
                          AutomationProperties.Name="{Binding Name}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                    <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="16,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE838;" Command="{Binding OpenCommand}"
                        Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}"
                        ToolTip="Open in File Explorer" AutomationProperties.Name="Open in File Explorer" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NoteIsWarning}" Value="True">
                    <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Grid Grid.Column="0" Margin="8,12,4,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,4,0,20">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="AppNameText" Text="Disk Cleaner" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnNavChanged"
                     AutomationProperties.Name="Sections" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Tag="Overview" AutomationProperties.Name="Overview" IsSelected="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Width="20" />
                        <TextBlock Text="Overview" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Cleanup" AutomationProperties.Name="Cleanup">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Width="20" />
                        <TextBlock Text="Cleanup" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Large" AutomationProperties.Name="Large files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Width="20" />
                        <TextBlock Text="Large files" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Folders" AutomationProperties.Name="Folders">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Width="20" />
                        <TextBlock Text="Folders" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Apps" AutomationProperties.Name="Apps">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" Width="20" />
                        <TextBlock Text="Apps" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Startup" AutomationProperties.Name="Startup apps">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" Width="20" />
                        <TextBlock Text="Startup apps" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Activity" AutomationProperties.Name="Activity">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Width="20" />
                        <TextBlock Text="Activity" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Network" AutomationProperties.Name="Network">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE968;" Width="20" />
                        <TextBlock Text="Network" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Docker" AutomationProperties.Name="Docker">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B8;" Width="20" />
                        <TextBlock Text="Docker" Margin="12,0,0,0" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="4,0">
                <TextBlock x:Name="AdminText" Style="{StaticResource Muted}" FontSize="12" Margin="8,0,0,6" />
                <Button x:Name="ThemeButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Click="OnThemeClick"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Glyph}" Text="&#xE793;" Width="20" />
                        <TextBlock x:Name="ThemeLabel" Text="Theme: System" Margin="12,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Pages -->
        <Grid Grid.Column="1">

            <!-- Overview -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,28,32,32">
                    <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="How full your drives are and what can be cleaned up." Style="{StaticResource Muted}" Margin="0,4,0,24" />

                    <ItemsControl x:Name="DriveList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="290" Margin="0,0,16,16" Focusable="True"
                                        AutomationProperties.Name="{Binding AccessibleText}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,0,6,0" />
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FreeText}" FontSize="24" FontWeight="SemiBold" Margin="0,14,0,10" />
                                        <ProgressBar x:Name="UsageBar" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="6"
                                                     AutomationProperties.Name="Used space" />
                                        <TextBlock Text="{Binding UsageText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="High">
                                        <Setter TargetName="UsageBar" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                        <Setter TargetName="UsageBar" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}" Margin="0,8,16,0" Padding="24">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Space you can reclaim" Style="{StaticResource Muted}" />
                                    <TextBlock x:Name="ReclaimTotal" Text="..." FontSize="32" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    <TextBlock x:Name="ReclaimSub" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="OverviewRescan" Content="Rescan" Padding="14,6" Click="OnRescan" />
                                    <Button Content="Review and clean" Padding="14,6" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="OnGoCleanup" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl x:Name="OverviewCats" Margin="0,20,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="2*" MinWidth="140" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Column="2" Value="{Binding Share, Mode=OneWay}" Maximum="100" Height="6" Margin="12,0"
                                                         AutomationProperties.Name="{Binding Title}" />
                                            <TextBlock Grid.Column="3" Text="{Binding TotalText}" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Cleanup -->
            <Grid x:Name="PageCleanup" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="32,28,32,16">
                    <StackPanel>
                        <TextBlock Text="Cleanup" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Pick what to remove. Nothing is deleted until you confirm." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="CleanupRescan" Content="Rescan" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRescan" />
                </Grid>

                <Border x:Name="AdminBanner" Grid.Row="1" Margin="32,0,32,16" Padding="16,12" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7EF;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Windows temp, update cache and system crash dumps need administrator rights." />
                        <Button Grid.Column="2" Content="Restart as administrator" Padding="12,5" Click="OnRestartAdmin" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CategoryList" Margin="32,0,32,16" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="8,10,16,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton IsChecked="{Binding IsExpanded}" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                                          VerticalAlignment="Center" ToolTip="Show items" AutomationProperties.Name="{Binding Title, StringFormat=Show items in {0}}">
                                                <TextBlock x:Name="Chevron" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" />
                                            </ToggleButton>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding AllChecked}" IsThreeState="False" MinWidth="0" Margin="4,0,4,0"
                                                      VerticalAlignment="Center" IsEnabled="{Binding HasCleanable}"
                                                      Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolVis}}"
                                                      AutomationProperties.Name="{Binding Title, StringFormat=Select all {0}}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="20" Margin="8,0,14,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="110">
                                                <TextBlock Text="{Binding TotalText}" FontSize="16" FontWeight="SemiBold" TextAlignment="Right" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12" TextAlignment="Right" />
                                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0"
                                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Scanning" />
                                            </StackPanel>
                                        </Grid>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,6"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CleanItemTemplate}" Focusable="False" />
                                                <TextBlock Text="Nothing to clean here on this PC." Style="{StaticResource Muted}" Margin="52,6,16,6"
                                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Text="{Binding HowTo}" TextWrapping="Wrap" Margin="52,8,24,10" LineHeight="20"
                                                           Visibility="{Binding HasHowTo, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="32,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedTotal" FontSize="16" FontWeight="SemiBold" Text="0 B selected" />
                            <TextBlock x:Name="SelectedSub" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                        <Button x:Name="CleanButton" Content="Clean selected..." Padding="18,7" HorizontalAlignment="Right"
                                Style="{DynamicResource AccentButtonStyle}" Click="OnCleanSelected" IsEnabled="False" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Large files -->
            <Grid x:Name="PageLarge" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="32,28,32,16">
                    <TextBlock Text="Large files" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Find big files anywhere on a drive. Windows, app and virtual disk files are listed but locked." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,16" Padding="16">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,8">
                                <Label Content="_Drive" Target="{Binding ElementName=DriveCombo}" Padding="0,0,0,4" />
                                <ComboBox x:Name="DriveCombo" Width="200" DisplayMemberPath="Display" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <Label Content="_Minimum size" Target="{Binding ElementName=SizeCombo}" Padding="0,0,0,4" />
                                <ComboBox x:Name="SizeCombo" Width="150" IsEditable="True" Text="500 MB"
                                          ToolTip="Pick a size or type one, such as 750 MB or 2 GB">
                                    <ComboBoxItem Content="100 MB" />
                                    <ComboBoxItem Content="250 MB" />
                                    <ComboBoxItem Content="500 MB" />
                                    <ComboBoxItem Content="1 GB" />
                                    <ComboBoxItem Content="2 GB" />
                                    <ComboBoxItem Content="5 GB" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <Button x:Name="LargeScanButton" Content="Scan" MinWidth="96" Padding="14,6" Style="{DynamicResource AccentButtonStyle}" Click="OnLargeScan" />
                                <Button x:Name="LargeStopButton" Content="Stop" MinWidth="80" Padding="14,6" Margin="8,0,0,0" Click="OnLargeStop" IsEnabled="False" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="LargeStatus" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="Pick a drive and press Scan." AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="LargeProgress" IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.Name="Scanning" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="32,0,32,16" Padding="0">
                    <Grid>
                        <ItemsControl x:Name="LargeList" Focusable="False" VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,6">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32">
                                            <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" VerticalAlignment="Center"
                                                      Visibility="{Binding CanSelect, Converter={StaticResource BoolVis}}" AutomationProperties.Name="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding IsProtected, Converter={StaticResource BoolVis}}" ToolTip="{Binding ProtectedReason}"
                                                       AutomationProperties.Name="Protected" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding ProtectedReason}" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding IsProtected, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource Muted}" FontSize="12" Margin="16,0" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" MinWidth="72" TextAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="8,0,0,0" Command="{Binding RevealCommand}"
                                                ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="LargeEmpty" Text="No results yet." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="32,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LargeSelected" FontSize="16" FontWeight="SemiBold" Text="0 B selected" />
                            <TextBlock x:Name="LargeSelectedSub" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                        <Button x:Name="LargeDeleteButton" Content="Delete selected..." Padding="18,7" HorizontalAlignment="Right"
                                Style="{DynamicResource AccentButtonStyle}" Click="OnLargeDelete" IsEnabled="False" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Docker -->
            <ScrollViewer x:Name="PageDocker" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,28,32,32">
                    <TextBlock Text="Docker" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Docker Desktop keeps images, containers and volumes inside one virtual disk file." Style="{StaticResource Muted}" Margin="0,4,0,24" />

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Virtual disk files" Style="{StaticResource SectionTitle}" />
                            <ItemsControl x:Name="VhdxList" Margin="0,12,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="VhdxEmpty" Text="No Docker Desktop disk found." Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="What's inside (docker system df)" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Button x:Name="DockerRefresh" Content="Refresh" Padding="14,5" HorizontalAlignment="Right" Click="OnDockerRefresh" />
                            </Grid>
                            <TextBox x:Name="DockerDf" Margin="0,12,0,0" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MinHeight="120"
                                     AutomationProperties.Name="Docker disk usage" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Remove unused data" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                                Runs <Run FontFamily="{StaticResource MonoFont}">docker system prune -a</Run>: removes stopped containers, unused networks,
                                every image no container uses, and the build cache. Images download again when you next need them.
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold">
                                Volumes are never removed: they hold your databases (for example Postgres data).
                            </TextBlock>
                            <Button x:Name="DockerPruneButton" Content="Prune unused data..." Padding="16,6" Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Style="{DynamicResource AccentButtonStyle}" Click="OnDockerPrune" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Shrink the virtual disk" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Text="A .vhdx file grows as Docker writes data but does not shrink by itself after a prune. Recent Docker Desktop versions give space back automatically over time; to reclaim it right away, compact the disk with these steps (they need administrator rights and Docker must be stopped):" />
                            <TextBox x:Name="CompactSteps" Margin="0,12,0,0" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     TextWrapping="Wrap" AutomationProperties.Name="Compaction steps" />
                            <Button Content="Copy steps" Padding="14,5" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OnCopySteps" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Folders -->
            <Grid x:Name="PageFolders" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="32,28,32,16">
                    <TextBlock Text="Folders" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="See what takes up space. Open a folder to look inside. This page only reads; nothing is deleted here." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,16" Padding="12">
                    <StackPanel>
                        <WrapPanel x:Name="FolderRoots" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FolderUp" Style="{StaticResource IconButton}" Content="&#xE74A;" Click="OnFolderUp" ToolTip="Up one level" AutomationProperties.Name="Up one level" />
                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FolderPath" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="FolderStatus" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Refresh" Padding="14,5" Click="OnFolderRefresh" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="32,0,32,24" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FolderList" Margin="0,6" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,4,16,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OpenBtn" Click="OnFolderOpen" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="6,4"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsEnabled="{Binding CanOpen}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Width="22" />
                                                <StackPanel Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <ProgressBar Grid.Column="1" Value="{Binding Share, Mode=OneWay}" Maximum="100" Height="6" Margin="12,0" VerticalAlignment="Center"
                                                     AutomationProperties.Name="{Binding Name, StringFormat=Share of {0}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="8,0,0,0" Command="{Binding RevealCommand}"
                                                ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Apps -->
            <Grid x:Name="PageApps" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="32,28,32,16">
                    <StackPanel>
                        <TextBlock Text="Apps" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Installed desktop apps by size. Sizes come from the installer or from measuring the install folder." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="Open Settings &gt; Apps" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnOpenAppSettings" />
                </Grid>
                <Grid Grid.Row="1" Margin="32,0,32,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="_Search" Target="{Binding ElementName=AppSearch}" VerticalAlignment="Center" Padding="0,0,10,0" />
                    <TextBox x:Name="AppSearch" Grid.Column="1" TextChanged="OnAppSearch" />
                    <TextBlock x:Name="AppsStatus" Grid.Column="2" Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="32,0,32,24" Padding="0">
                    <ItemsControl x:Name="AppList" Focusable="False" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,6">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="16,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="2" Value="{Binding Share, Mode=OneWay}" Maximum="100" Height="6" Margin="12,0" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding Name, StringFormat=Size of {0}}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="8,0,0,0" Command="{Binding OpenCommand}"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}" ToolTip="Open install folder" AutomationProperties.Name="Open install folder" />
                                    <Button Grid.Column="5" Content="Uninstall..." Padding="10,4" Margin="8,0,0,0" Click="OnUninstall" Tag="{Binding}"
                                            IsEnabled="{Binding CanUninstall}" AutomationProperties.Name="{Binding Name, StringFormat=Uninstall {0}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- Startup apps -->
            <Grid x:Name="PageStartup" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="32,28,32,16">
                    <StackPanel>
                        <TextBlock Text="Startup apps" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Apps that start when you sign in. Turning one off only stops it starting automatically; nothing is uninstalled, and you can turn it back on here or in Task Manager." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,24" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,6">
                            <ItemsControl x:Name="StartupList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Margin="4,0,16,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource Muted}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanChange}" Content="{Binding StatusText}"
                                                      VerticalAlignment="Center" MinWidth="170" AutomationProperties.Name="{Binding Name, StringFormat={}{0} starts with Windows}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="StartupEmpty" Text="No startup apps found." Style="{StaticResource Muted}" Margin="16,8" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Activity -->
            <Grid x:Name="PageActivity" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="32,28,32,16">
                    <TextBlock Text="Activity" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Which apps use memory, CPU, disk and network right now. Updates every 2 seconds while this page is open." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="3" Margin="26,0,26,16">
                    <Border Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="Memory" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="MemText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8" Text="-" />
                            <ProgressBar x:Name="MemBar" Maximum="100" Height="6" AutomationProperties.Name="Memory in use" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="CpuText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8" Text="-" />
                            <ProgressBar x:Name="CpuBar" Maximum="100" Height="6" AutomationProperties.Name="CPU in use" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="Network (all apps)" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="NetText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,8" Text="-" />
                            <TextBlock x:Name="NetSub" Style="{StaticResource Muted}" FontSize="12" Text="Download / upload speed" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="32,0,32,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <RadioButton x:Name="SortMem" GroupName="ActSort" Content="Memory" IsChecked="True" Margin="0,0,8,0" MinWidth="0" Checked="OnActivitySort" />
                        <RadioButton x:Name="SortCpu" GroupName="ActSort" Content="CPU" Margin="0,0,8,0" MinWidth="0" Checked="OnActivitySort" />
                        <RadioButton x:Name="SortIo" GroupName="ActSort" Content="Disk + network I/O" Margin="0,0,8,0" MinWidth="0" Checked="OnActivitySort" />
                        <RadioButton x:Name="SortConn" GroupName="ActSort" Content="Connections" MinWidth="0" Checked="OnActivitySort" />
                    </WrapPanel>
                    <Label Grid.Column="2" Content="Fi_lter" Target="{Binding ElementName=ActivitySearch}" VerticalAlignment="Center" Padding="16,0,10,0" />
                    <TextBox x:Name="ActivitySearch" Grid.Column="3" TextChanged="OnActivityFilter" />
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="32,0,32,24" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,10,16,6" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextElement.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="App" Margin="28,0,0,0" />
                            <TextBlock Grid.Column="1" Text="Memory" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="CPU" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="I/O" TextAlignment="Right" ToolTip="Disk and network reads and writes per second" />
                            <TextBlock Grid.Column="4" Text="Connections" TextAlignment="Right" ToolTip="Open internet connections (TCP)" />
                        </Grid>
                        <ItemsControl x:Name="ActivityList" Grid.Row="1" Focusable="False" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding MemoryShare, Mode=OneWay}" Maximum="100" Height="4" Width="70" HorizontalAlignment="Left" Margin="8,0,0,0"
                                                         AutomationProperties.Name="Memory share" />
                                            <TextBlock Text="{Binding MemoryText}" TextAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding IoText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding ConnectionsText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Command="{Binding RevealCommand}"
                                                    ToolTip="Show in File Explorer" AutomationProperties.Name="Show in File Explorer" />
                                            <Button Content="End" Padding="10,3" Margin="4,0,0,0" Click="OnEndTask" Tag="{Binding}" IsEnabled="{Binding CanEnd}"
                                                    ToolTip="End task" AutomationProperties.Name="{Binding Name, StringFormat=End {0}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- Network -->
            <Grid x:Name="PageNetwork" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="32,28,32,16">
                    <TextBlock Text="Network" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Which apps are connected where. Only connection details are read; the content of the traffic is never captured." Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>

                <Border x:Name="NetAdminBanner" Grid.Row="1" Margin="32,0,32,12" Padding="16,12" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7EF;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Run as administrator to see how much data each connection sends and receives." />
                        <Button Grid.Column="2" Content="Restart as administrator" Padding="12,5" Click="OnRestartAdmin" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="NetApps" Grid.Row="2" Margin="32,0,32,8" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,8" MaxWidth="320">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="3" Margin="32,0,32,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ShowListening" Content="Show listening ports" Checked="OnNetOption" Unchecked="OnNetOption" />
                    <TextBlock x:Name="NetCount" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0" />
                    <Label Grid.Column="2" Content="Fi_lter" Target="{Binding ElementName=NetSearch}" VerticalAlignment="Center" Padding="0,0,10,0" />
                    <TextBox x:Name="NetSearch" Grid.Column="3" TextChanged="OnNetFilter" ToolTip="App, host, address or port" />
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="32,0,32,24" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,10,16,6" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextElement.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="App" Margin="28,0,0,0" />
                            <TextBlock Grid.Column="1" Text="Connected to" />
                            <TextBlock Grid.Column="2" Text="Service" />
                            <TextBlock Grid.Column="3" Text="State" />
                            <TextBlock Grid.Column="4" Text="Received / sent" TextAlignment="Right" />
                        </Grid>
                        <ItemsControl x:Name="NetList" Grid.Row="1" Focusable="False" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding AppName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding RemoteText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RemoteText}" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding PortText}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding State}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TrafficText}" TextAlignment="Right" />
                                            <TextBlock Text="{Binding RateText}" Style="{StaticResource Muted}" FontSize="11" TextAlignment="Right" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- Busy overlay while deleting or pruning -->
            <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#66000000">
                <Border Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <StackPanel>
                        <TextBlock x:Name="BusyTitle" Text="Cleaning..." Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="BusyDetail" Style="{StaticResource Muted}" Margin="0,6,0,14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar IsIndeterminate="True" Height="4" AutomationProperties.Name="Working" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
