<Window x:Class="DiskCleaner.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,8,0,16" Style="{StaticResource Muted}" />

        <Border Grid.Row="2" x:Name="ListBorder" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowList" Focusable="False" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="RowName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolVis}}" ToolTip="{Binding Detail}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="16,0,0,0" FontWeight="SemiBold" VerticalAlignment="Top" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter TargetName="RowName" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" x:Name="TotalRow" Margin="16,12,16,0">
            <TextBlock x:Name="TotalLabel" Text="Total" FontWeight="SemiBold" />
            <TextBlock x:Name="TotalText" HorizontalAlignment="Right" FontWeight="SemiBold" />
        </Grid>

        <StackPanel Grid.Row="4" x:Name="ModePanel" Margin="0,16,0,0">
            <RadioButton x:Name="RecycleOption" GroupName="Mode" IsChecked="True" Content="Move to the Recycle Bin (you can restore them)" />
            <RadioButton x:Name="PermanentOption" GroupName="Mode" Margin="0,6,0,0" Content="Delete permanently (frees space now, can't be undone)" />
            <TextBlock x:Name="ModeNote" Margin="0,8,0,0" Style="{StaticResource Muted}" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="110" Padding="16,6" IsCancel="True" Click="OnCancel" />
            <Button x:Name="OkButton" MinWidth="130" Padding="16,6" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
